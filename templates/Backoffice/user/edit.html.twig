{% extends 'base.html.twig' %}

{% block title %}Edit User{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1>Edit User</h1>

        {{ form_start(form, {'attr': {'onsubmit': 'return confirm("Are you sure you want to update this user?");'}}) }}

        <!-- Username Field -->
        <div class="mb-3">
            {{ form_label(form.username) }}
            {{ form_widget(form.username, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.username) }}
        </div>

        <!-- Email Field -->
        <div class="mb-3">
            {{ form_label(form.email) }}
            {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.email) }}
        </div>

        <!-- Password Field -->
        <div class="mb-3">
            {{ form_label(form.password) }}
            {{ form_widget(form.password, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.password) }}
        </div>

        <!-- Delivery Address Field -->
        <div class="mb-3">
            {{ form_label(form.deliveryAddress) }}
            {{ form_widget(form.deliveryAddress, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.deliveryAddress) }}
        </div>

        <!-- Roles Field (Checkboxes) -->
        <div class="mb-3">
            <label class="font-weight-bold">Roles</label>
            <div>
                {% for role, value in form.roles %}
                    <div class="form-check">
                        {{ form_widget(value, {'attr': {'class': 'form-check-input'}}) }}
                        {{ form_label(value, role, {'label_attr': {'class': 'form-check-label'}}) }}
                    </div>
                {% endfor %}
            </div>
            {{ form_errors(form.roles) }}
        </div>

        <!-- Lessons Field -->
        <div class="mb-3">
            {{ form_label(form.lessons) }}
            {{ form_widget(form.lessons, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.lessons) }}
        </div>

        <!-- Purchased Courses Field -->
        <div class="mb-3">
            {{ form_label(form.purchasedCourses) }}
            {{ form_widget(form.purchasedCourses, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.purchasedCourses) }}
        </div>

        <!-- Is Verified Field (Checkbox) -->
        <div class="mb-3">
            {{ form_label(form.isVerified) }}
            {{ form_widget(form.isVerified, {'attr': {'class': 'form-check-input'}}) }}
            {{ form_errors(form.isVerified) }}
        </div>

        <!-- Submit Button -->
        <div class="mt-4">
            <button type="submit" class="btn btn-success">Update User</button>
            <a href="{{ path('admin_backoffice') }}" class="btn btn-secondary ml-2">Back to List</a>
        </div>

        {{ form_end(form) }}
    </div>
{% endblock %}
