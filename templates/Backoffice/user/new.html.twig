{% extends 'base.html.twig' %}

{% block title %}Add a New User
{% endblock %}

{% block body %}
	<div class="container mt-5">
		<div class="row">
			<div class="col-md-8 offset-md-2">
				<h1 class="text-center mb-4">Add a New User</h1>

				<div class="card shadow-sm">
					<div class="card-body">
						{{ form_start(form, {'attr': {'onsubmit': 'return confirm("Are you sure you want to add this user?");'}}) }}

						<!-- Username Field -->
						<div class="mb-3">
							{{ form_label(form.username, 'Username', {'label_attr': {'class': 'font-weight-bold'}}) }}
							{{ form_widget(form.username, {'attr': {'class': 'form-control', 'placeholder': 'Enter username'}}) }}
							{{ form_errors(form.username) }}
						</div>

						<!-- Email Field -->
						<div class="mb-3">
							{{ form_label(form.email, 'Email', {'label_attr': {'class': 'font-weight-bold'}}) }}
							{{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'Enter email address'}}) }}
							{{ form_errors(form.email) }}
						</div>

						<!-- Password Field -->
						<div class="mb-3">
							{{ form_label(form.password, 'Password', {'label_attr': {'class': 'font-weight-bold'}}) }}
							{{ form_widget(form.password, {'attr': {'class': 'form-control', 'placeholder': 'Enter password'}}) }}
							{{ form_errors(form.password) }}
						</div>

						<!-- Delivery Address Field -->
						<div class="mb-3">
							{{ form_label(form.deliveryAddress, 'Delivery Address', {'label_attr': {'class': 'font-weight-bold'}}) }}
							{{ form_widget(form.deliveryAddress, {'attr': {'class': 'form-control', 'placeholder': 'Enter delivery address (optional)'}}) }}
							{{ form_errors(form.deliveryAddress) }}
						</div>

						<!-- Roles Field (Checkboxes) -->
						<div class="mb-3">
							<label class="font-weight-bold">Roles</label>
							<div>
								{% for role, value in form.roles %}
									<div class="form-check">
										{{ form_widget(value, {'attr': {'class': 'form-check-input'}}) }}
										{{ form_label(value, role, {'label_attr': {'class': 'form-check-label'}}) }}
									</div>
								{% endfor %}
							</div>
							{{ form_errors(form.roles) }}
						</div>

						<!-- Lessons Field -->
						<div class="mb-3">
							{{ form_label(form.lessons, 'Lessons', {'label_attr': {'class': 'font-weight-bold'}}) }}
							{{ form_widget(form.lessons, {'attr': {'class': 'form-control'}}) }}
							{{ form_errors(form.lessons) }}
						</div>

						<!-- Purchased Courses Field -->
						<div class="mb-3">
							{{ form_label(form.purchasedCourses, 'Purchased Courses', {'label_attr': {'class': 'font-weight-bold'}}) }}
							{{ form_widget(form.purchasedCourses, {'attr': {'class': 'form-control'}}) }}
							{{ form_errors(form.purchasedCourses) }}
						</div>

						<!-- Verified Field -->
						<div class="mb-3">
							{{ form_label(form.isVerified, 'Verified', {'label_attr': {'class': 'font-weight-bold'}}) }}
							{{ form_widget(form.isVerified, {'attr': {'class': 'form-check-input'}}) }}
							{{ form_errors(form.isVerified) }}
						</div>

						<!-- Submit Button -->
						<div class="d-flex justify-content-between">
							<button type="submit" class="btn btn-success">
								<i class="fas fa-plus"></i>
								Add User
							</button>
							<a href="{{ path('admin_backoffice') }}" class="btn btn-secondary">
								<i class="fas fa-arrow-left"></i>
								Back to List
							</a>
						</div>

						{{ form_end(form) }}
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
