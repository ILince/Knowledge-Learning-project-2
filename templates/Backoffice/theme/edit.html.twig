{% extends 'base.html.twig' %}

{% block title %}Edit Theme{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1>Edit Theme: {{ theme.name }}</h1>

        {{ form_start(form, {'attr': {'onsubmit': 'return confirm("Are you sure you want to save the changes to this theme?");'}}) }}
        
        <!-- Theme Name Field -->
        <div class="mb-3">
            {{ form_label(form.name) }}
            {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.name) }}
        </div>

        <!-- Associated Courses Section -->
        <h3>Associated Courses:</h3>
        {% if theme.courses|length > 0 %}
            <ul>
                {% for course in theme.courses %}
                    <li>{{ course.name }} - {{ course.price|number_format(2, ',', ' ') }} €
                        <ul>
                            {% for lesson in course.lessons %}
                                <li>{{ lesson.name }}</li>
                            {% endfor %}
                        </ul>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p>No courses associated with this theme.</p>
        {% endif %}

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a href="{{ path('admin_backoffice') }}" class="btn btn-secondary ml-2">Back to Back-office</a>
        </div>

        {{ form_end(form) }}
    </div>
{% endblock %}
