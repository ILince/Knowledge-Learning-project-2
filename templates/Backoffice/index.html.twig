{% extends 'base.html.twig' %}

{% block title %}Backoffice
{% endblock %}

{% block body %}
	<div class="container-fluid mt-5">
		<h1 class="mb-4">Backoffice</h1>

		<!-- Section for User Management -->
		<section id="users" class="container mt-4">
			<h2 class="text-center">User Management</h2>
			<a href="{{ path('app_user_new') }}" class="btn btn-primary mb-3">Add a User</a>

			{% if users is empty %}
				<div class="alert alert-warning text-center">No users available.</div>
			{% else %}
				<div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
					<table class="table table-striped text-center">
						<thead>
							<tr>
								<th>#</th>
								<th>Username</th>
								<th>Email</th>
								<th>Roles</th>
								<th>Actions</th>
							</tr>
						</thead>
						<tbody>
							{% for user in users %}
								<tr>
									<td>{{ user.id }}</td>
									<td>{{ user.username }}</td>
									<td>{{ user.email }}</td>
									<td>{{ user.roles|join(', ') }}</td>
									<td>
										<a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-warning btn-sm">Edit</a>
										<form action="{{ path('app_user_delete', {'id': user.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Are you sure?');">
											<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
											<button type="submit" class="btn btn-danger btn-sm">Delete</button>
										</form>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			{% endif %}
		</section>


		<hr>

		<!-- Section for Course Management -->
		<section id="courses" class="container mt-4">
			<h2 class="text-center">Course Management</h2>
			<a href="{{ path('app_course_new') }}" class="btn btn-primary mb-3">Add a Course</a>

			{% if courses is empty %}
				<div class="alert alert-warning text-center">No courses available.</div>
			{% else %}
				<div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
					<table class="table table-striped text-center">
						<thead>
							<tr>
								<th>#</th>
								<th>Name</th>
								<th>Theme</th>
								<th>Price</th>
								<th>Actions</th>
							</tr>
						</thead>
						<tbody>
							{% for course in courses %}
								<tr>
									<td>{{ course.id }}</td>
									<td>{{ course.name }}</td>
									<td>{{ course.theme.name }}</td>
									<td>{{ course.price|number_format(2, ',', ' ') }}
										€</td>
									<td>
										<a href="{{ path('app_course_edit', {'id': course.id}) }}" class="btn btn-warning btn-sm">Edit</a>
										<form action="{{ path('app_course_delete', {'id': course.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Are you sure?');">
											<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ course.id) }}">
											<button type="submit" class="btn btn-danger btn-sm">Delete</button>
										</form>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			{% endif %}
		</section>


		<hr>

		<!-- Section for Lesson Management -->
		<section id="lessons" class="container mt-4">
			<h2 class="text-center">Lesson Management</h2>
			<a href="{{ path('app_lesson_new') }}" class="btn btn-primary mb-3">Add a Lesson</a>

			{% if lessons is empty %}
				<div class="alert alert-warning text-center">No lessons available.</div>
			{% else %}
				<div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
					<table class="table table-striped text-center">
						<thead>
							<tr>
								<th>#</th>
								<th>Name</th>
								<th>Associated Course</th>
								<th>Price</th>
								<th>Actions</th>
							</tr>
						</thead>
						<tbody>
							{% for lesson in lessons %}
								<tr>
									<td>{{ lesson.id }}</td>
									<td>{{ lesson.name }}</td>
									<td>{{ lesson.course.name }}</td>
									<td>{{ lesson.price|number_format(2, ',', ' ') }}
										€</td>
									<td>
										<a href="{{ path('app_lesson_edit', {'id': lesson.id}) }}" class="btn btn-warning btn-sm">Edit</a>
										<form action="{{ path('app_lesson_delete', {'id': lesson.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Are you sure?');">
											<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ lesson.id) }}">
											<button type="submit" class="btn btn-danger btn-sm">Delete</button>
										</form>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			{% endif %}
		</section>


		<hr>

		<!-- Section for Theme Management -->
		<section id="themes" class="container mt-4">
			<h2 class="text-center">Theme Management</h2>
			<a href="{{ path('app_theme_new') }}" class="btn btn-primary mb-3">Add a Theme</a>

			{% if themes is empty %}
				<div class="alert alert-warning text-center">No themes available.</div>
			{% else %}
				<div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
					<table class="table table-striped text-center">
						<thead>
							<tr>
								<th>#</th>
								<th>Name</th>
								<th>Actions</th>
							</tr>
						</thead>
						<tbody>
							{% for theme in themes %}
								<tr>
									<td>{{ theme.id }}</td>
									<td>{{ theme.name }}</td>
									<td>
										<a href="{{ path('app_theme_edit', {'id': theme.id}) }}" class="btn btn-warning btn-sm">
											<i class="fa fa-pencil"></i>
											Edit
										</a>
										<form action="{{ path('app_theme_delete', {'id': theme.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this theme?');">
											<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ theme.id) }}">
											<button type="submit" class="btn btn-danger btn-sm">
												<i class="fa fa-trash"></i>
												Delete
											</button>
										</form>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			{% endif %}
		</section>

	</div>
{% endblock %}
