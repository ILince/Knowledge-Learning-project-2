<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta
		name="description" content="Knowledge Learning - Your go-to platform for learning new skills.">

		<!-- Page Title -->
		<title>
			{% block title %}Knowledge Learning
			{% endblock %}
		</title>

		<!-- Favicon -->
		<link
		rel="icon" href="{{ asset('images/Knowledge-Learning-flavicon.png') }}" type="image/x-icon">

		<!-- Bootstrap CSS -->
		<link
		href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

		<!-- Custom CSS -->
		<link rel="stylesheet" href="{{ asset('styles/app.css') }}"> {% block stylesheets %}{% endblock %}
		</head>

		<body>
			<!-- Header Section -->
			<header>
				<!-- Navigation Bar -->
				{% include "layouts/nav.html.twig" %}

				<!-- Flash Messages for Success -->
				{% for message in app.flashes('success') %}
					<div class="alert alert-success">{{ message }}</div>
				{% endfor %}

				<!-- Flash Messages for Errors -->
				{% for message in app.flashes('error') %}
					<div class="alert alert-danger">{{ message }}</div>
				{% endfor %}
			</header>

			<!-- Main Page Content -->
			<div class="container-fluid"> {% block body %}{% endblock %}
				</div>

				<!-- Footer Section -->
				<footer>
					{% include "layouts/footer.html.twig" %}
				</footer>

				<!-- Bootstrap JS -->
				<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

				<!-- Custom JS -->
				<script src="{{ asset('js/scripts.js') }}"></script>
			</body>
		</html>
